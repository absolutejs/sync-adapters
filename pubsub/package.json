{
	"name": "@absolutejs/sync-pubsub",
	"version": "0.1.0",
	"description": "Google Cloud Pub/Sub StreamingPull reaction for AbsoluteJS Sync",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/sync-adapters.git",
		"directory": "pubsub"
	},
	"homepage": "https://github.com/absolutejs/sync-adapters/tree/main/pubsub",
	"bugs": {
		"url": "https://github.com/absolutejs/sync-adapters/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Alex Kahn",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"absolutejs",
		"sync",
		"google",
		"pubsub",
		"streaming"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=node --packages=external && tsc --project tsconfig.build.json && absolute-manifest emit",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"peerDependencies": {
		"@absolutejs/sync": ">=3 <4",
		"@google-cloud/pubsub": ">=6.3.2 <7"
	},
	"devDependencies": {
		"@absolutejs/sync": "3.2.0",
		"@types/bun": "1.3.14",
		"prettier": "3.5.3",
		"typescript": "5.8.3",
		"@google-cloud/pubsub": "6.3.2"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"absolutejs": {
		"manifestContract": 2
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.9.0",
		"@sinclair/typebox": "^0.34.0"
	}
}
