{
	"name": "@absolutejs/sync-bus-pg",
	"version": "0.2.0",
	"description": "Typed Postgres LISTEN/NOTIFY channel and @absolutejs/sync cluster bus — horizontal scale without standing up Redis",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/sync-adapters.git",
		"directory": "bus-pg"
	},
	"homepage": "https://github.com/absolutejs/sync-adapters/tree/main/bus-pg",
	"bugs": {
		"url": "https://github.com/absolutejs/sync-adapters/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Alex Kahn",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"absolutejs",
		"sync",
		"cluster",
		"postgres",
		"listen-notify",
		"horizontal-scale"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/sync --external postgres && tsc --project tsconfig.build.json && absolute-manifest emit",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"peerDependencies": {
		"@absolutejs/sync": ">= 1.0.0",
		"postgres": "^3.0.0"
	},
	"devDependencies": {
		"@absolutejs/sync": "^1.18.2",
		"@types/bun": "1.3.14",
		"postgres": "^3.4.9",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"absolutejs": {
		"manifestContract": 1
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.1.0",
		"@sinclair/typebox": "^0.34.0"
	}
}
